<Application x:Class="FT857DControl.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Chassis" Color="#17191A"/><SolidColorBrush x:Key="Panel" Color="#202324"/>
  <SolidColorBrush x:Key="Lcd" Color="#E98B17"/><SolidColorBrush x:Key="LcdInk" Color="#17110A"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F2A52A"/><Setter Property="Background" Value="#17191A"/><Setter Property="BorderBrush" Value="#505456"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="3"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#242728"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#555A5D"/><Setter Property="Padding" Value="5,3"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#D9D9D9"/><Setter Property="BorderBrush" Value="#3E4345"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
 </Application.Resources>
</Application>
